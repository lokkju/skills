{
  "name": "@lokkju/skills",
  "version": "2026.10.26",
  "description": "lokkju's agent skills and commands as an OpenCode plugin: forge-release, forge-tracker, session-decisions, term-recorder and worktree-tidy.",
  "type": "module",
