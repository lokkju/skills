{
  "description": "Numbers and checks DECIDE/ACTION items as they're created in the task list, and re-shows open items after compaction or resume.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "TaskCreate",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/decisions.py\" hook-pretooluse",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/decisions.py\" hook-sessionstart",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
